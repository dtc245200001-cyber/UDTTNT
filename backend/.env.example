# Google Gemini API Key
# Lấy API key miễn phí tại: https://aistudio.google.com/app/apikey
# Có thể dùng 1 key: GEMINI_API_KEY=key1
# Hoặc nhiều key cách nhau bằng dấu phẩy để hệ thống tự động xoay vòng khi hết Quota (Rate limit 429)
GEMINI_API_KEYS=YOUR_GEMINI_API_KEYS_HERE

# Cấu hình Model AI
# Các model phổ biến khuyên dùng (Google GenAI SDK):
# - gemini-3.5-flash (Nhanh nhất, thông minh, mặc định)
# - gemini-2.5-flash (Rất nhanh, ổn định)
# - gemini-2.5-pro   (Thông minh, dùng cho suy luận phức tạp)
GEMINI_MODEL_NAME=gemini-3.5-flash

# Supabase Configuration
# Thông tin kết nối Supabase
SUPABASE_URL=YOUR_SUPABASE_URL_HERE
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# Frontend Configuration
# URL của Frontend để thiết lập CORS
FRONTEND_URL=YOUR_FRONTEND_URL_HERE
